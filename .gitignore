# =====================================================================
# WodBusted - .gitignore
# =====================================================================

# Environment variables & sensitive credentials (NEVER COMMIT)
.env
.env.local
.env.*.local
*.key
.secret.key

# SQLite Database & Write-Ahead-Log files
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Logs and runtime dumps
*.log
bot.log
drakkar-bot*.log
drakkar-bot-*.log

# Python virtual environment & bytecode
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# OS & Editor artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
