# =====================================================================
# CONFIGURACIÓN DRAKKAR WODBUSTER TELEGRAM BOT
# =====================================================================

# Token obtenido de @BotFather en Telegram (OBLIGATORIO)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# URL del Box de Drakkar (por defecto: https://drakkar.wodbuster.com)
WODBUSTER_BOX_URL=https://drakkar.wodbuster.com

# Identificador de subdominio del Box
WODBUSTER_BOX_NAME=drakkar

# Zona Horaria (España peninsular)
TIMEZONE=Europe/Madrid

# Clave de cifrado opcional para la base de datos (si se deja vacía, se genera automáticamente una segura)
ENCRYPTION_KEY=
